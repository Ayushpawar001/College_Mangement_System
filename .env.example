# ============================================
# COLLEGE MANAGEMENT SYSTEM - EXAMPLE ENV
# Copy this file to .env and fill in values
# ============================================

# --- Application ---
PORT=5000
SECRET_KEY=your-secret-key-here

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=college_db

# --- SSL (set true for cloud/Render deployment) ---
DB_SSL=false
